{
  "tools": [
    {
      "id": "geoly",
      "displayName": "GEOly CLI",
      "description": "GEOly 连接器 CLI —— 浏览器登录 GEOly 账号，并把 GEOly 远程 MCP（品牌 AI 可见度、引用分析、竞品与公开行业情报）桥接为本地 stdio MCP。随插件打包（零依赖，Accio 自带 node runtime 运行），不从 npm 拉取。",
      "usageExamples": [
        "geoly-accio-mcp --version",
        "geoly-accio-mcp login",
        "geoly-accio-mcp status"
      ],
      "verifyArgs": ["--version"],
      "exposure": "all-agents",
      "source": {
        "type": "node-cli",
        "entry": "clis/geoly/bin/cli.mjs",
        "commandName": "geoly-accio-mcp",
        "moduleFormat": "esm"
      }
    }
  ]
}
